{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -- --configuration production",
  "outputDirectory": "dist/frontend/browser",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/v1/finance/:path*",
      "destination": "https://REPLACE_WITH_FINANCE_RENDER_HOST/api/v1/finance/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_IDENTITY_RENDER_HOST/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
