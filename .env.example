# PostgreSQL local; replace credentials before deploying.
POSTGRES_DB=aethereon_erp
POSTGRES_USER=aethereon
POSTGRES_PASSWORD=change_me_before_running
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:15432/aethereon_erp
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:42000,http://127.0.0.1:42000
IDENTITY_PORT=10001
PLATFORM_PORT=10002
ANGULAR_SHELL_PORT=42000
PYTHON_VERSION=3.11.8
