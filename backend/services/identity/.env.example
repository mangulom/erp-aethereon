# Copy to .env for standalone runs; never commit real credentials.
DATABASE_URL=postgresql+psycopg2://aethereon:REPLACE_WITH_LOCAL_ROLE_PASSWORD@localhost:15432/aethereon_erp
JWT_SECRET_KEY=generate_a_random_secret_at_least_32_bytes
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
JWT_EXPIRE_MINUTES=60
SERVICE_PORT=18001
IDENTITY_PORT=18001
IDENTITY_HOST=127.0.0.1
IDENTITY_AUTO_PORT=false
IDENTITY_UPDATE_FRONTEND_PROXY=true
